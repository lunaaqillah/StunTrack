# Salin file ini jadi ".env" (di folder yang sama), lalu isi nilai aslinya.
# File ".env" TIDAK ikut ter-commit ke git / ke-share (lihat .gitignore) --
# taruh semua rahasia (password, secret key) di situ, JANGAN di file kode.

# --- Session / login admin ---
# Kunci rahasia buat menandatangani session cookie. Isi string acak yang
# panjang, contoh cara generate cepat lewat terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
STUNTRACK_SECRET_KEY=

# --- Akun admin default (dibuat otomatis saat app pertama kali dijalankan) ---
STUNTRACK_ADMIN_EMAIL=admin@example.com
STUNTRACK_ADMIN_PASSWORD=

# --- Email (Gmail) ---
# STUNTRACK_MAIL_PASSWORD harus Gmail App Password (16 karakter), BUKAN
# password akun Gmail biasa. Buat di: Google Account -> Security -> App
# Passwords. Kalau app password yang lama pernah kebuka/dibagikan ke orang
# lain, revoke dulu yang lama sebelum bikin yang baru.
STUNTRACK_MAIL_USERNAME=stuntingtracking@gmail.com
STUNTRACK_MAIL_PASSWORD=

# --- (Opsional) alamat tujuan notifikasi form kontak publik ---
# Kalau dikosongkan, otomatis pakai STUNTRACK_MAIL_USERNAME di atas.
STUNTRACK_CONTACT_EMAIL=

# --- (Opsional) base URL untuk link di email, kalau deploy di belakang
# reverse proxy / domain custom. Kalau dikosongkan, otomatis dideteksi dari
# request yang masuk (aman untuk localhost maupun saat online).
APP_BASE_URL=
